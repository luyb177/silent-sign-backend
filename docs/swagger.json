    "/api/v1/auth/login": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "schemes": [
          "https"
        ],
        "tags": [
          "认证模块"
        ],
        "summary": "登录账号",
        "operationId": "authLogin",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "target",
                "channel",
                "password"
              ],
              "properties": {
                "channel": {
                  "description": "1: email, 2: phone",
                  "type": "integer"
                },
                "password": {
                  "description": "密码",
                  "type": "string"
                },
                "target": {
                  "description": "email or phone",
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string"
                },
                "user_info": {
                  "type": "object",
                  "required": [
                    "user_id",
                    "username",
                    "email",
                    "avatar",
                    "created_at"
                  ],
                  "properties": {
                    "avatar": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "user_id": {
                      "type": "integer"
                    },
                    "username": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
