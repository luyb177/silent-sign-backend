      "get": {
        "produces": [
          "application/json"
        ],
        "schemes": [
          "https"
        ],
        "tags": [
          "评论模块"
        ],
        "summary": "分页获取评论列表",
        "operationId": "commentListComments",
        "parameters": [
          {
            "type": "integer",
            "name": "target_type",
            "in": "query",
            "required": true
          },
          {
            "type": "integer",
            "name": "target_id",
            "in": "query",
            "required": true
          },
          {
            "type": "integer",
            "description": "0=父评论列表, \u003e0=子评论列表",
            "name": "father_id",
            "in": "query",
            "allowEmptyValue": true
          },
          {
            "type": "integer",
            "name": "page_size",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "name": "page_token",
