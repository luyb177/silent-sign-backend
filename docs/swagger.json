            "schema": {
              "type": "object",
              "properties": {
                "comments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "comment_id",
                      "created_at",
                      "father_id",
                      "creator",
                      "location",
                      "content",
                      "like_num",
                      "sub_num",
                      "is_liked"
                    ],
                    "properties": {
                      "comment_id": {
                        "type": "integer"
                      },
                      "content": {
                        "type": "string"
                      },
                      "created_at": {
                        "type": "string"
                      },
                      "creator": {
                        "type": "object",
                        "required": [
                          "user_id",
                          "name",
                          "avatar"
                        ],
                        "properties": {
                          "avatar": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "user_id": {
                            "type": "integer"
                          }
                        }
                      },
                      "father_id": {
                        "description": "父评论ID，0表示一级评论",
                        "type": "integer"
                      },
                      "is_liked": {
                        "type": "boolean"
                      },
                      "like_num": {
                        "type": "integer"
                      },
                      "location": {
                        "type": "string"
                      },
                      "sub_num": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "has_more": {
                  "type": "boolean"
                },
                "page_token": {
                  "type": "string"
                }
              }
            }
          }
