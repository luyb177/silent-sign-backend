syntax = "v1"

info (
	title:   "silent-sign API"
	desc:    "无声之韵智能手语双向翻译系统 API"
	author:  "silent-sign team"
	version: "1.0"
)

// ══════════════════════════════════════════════
// Common
// ══════════════════════════════════════════════
// model
type (
	AuthUser {
		UserID uint64 `json:"user_id"`
	}
	IPLocation {
		IP       string `json:"ip"`
		Country  string `json:"country"`
		Province string `json:"province"`
		City     string `json:"city"`
		ISP      string `json:"isp"`
		ISOCode  string `json:"iso_code"`
	}
	UserInfo {
		UserID    uint64 `json:"user_id"`
		Username  string `json:"username"`
		Email     string `json:"email"`
		Avatar    string `json:"avatar"`
		CreatedAt string `json:"created_at"`
	}
)

// response
type (
	Response  {}
)

// ══════════════════════════════════════════════
// Auth（无需 JWT）
// ══════════════════════════════════════════════
// request
type (
	SendVerificationCodeReq {
		Target  string `json:"target"` // email or phone
		Channel int32  `json:"channel"` // 1: email, 2: phone
		Purpose int32  `json:"purpose"` // 1: registration, 2: password reset
	}
	RegisterReq {
		Target   string `json:"target"` // email or phone
		Channel  int32  `json:"channel"` // 1: email, 2: phone
		Code     string `json:"code"` // 验证码
		Password string `json:"password"` // 密码
	}
	LoginReq {
		Target   string `json:"target"` // email or phone
		Channel  int32  `json:"channel"` // 1: email, 2: phone
		Password string `json:"password"` // 密码
	}
)

// response
type (
	LoginResp {
		Token    string   `json:"token"`
		UserInfo UserInfo `json:"user_info"`
	}
)

@server (
	prefix:     /api/v1/auth
	tags:       "认证模块"
	group:      auth
	middleware: IPMiddleware
)
service silent_sign {
	@doc "发送验证码"
	@handler SendVerificationCode
	get /send_code (SendVerificationCodeReq) returns (Response)

	@doc "注册账号"
	@handler Register
	post /register (RegisterReq) returns (Response)

	@doc "登录账号"
	@handler Login
	post /login (LoginReq) returns (LoginResp)
}

